{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secret-mcp.local/schemas/implementation-audit-input-v3.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "run", "node", "contract", "evidence", "implementation", "policy", "payload"],
  "properties": {
    "schemaVersion": { "const": "design-validation/implementation-audit-input/v3" },
    "run": {
      "type": "object",
      "required": ["runId", "targetId", "repository", "baseCommit", "requestedAt"],
      "properties": {
        "runId": { "type": "string" }, "targetId": { "type": "string" },
        "repository": { "type": "string" }, "baseCommit": { "type": "string" },
        "requestedAt": { "type": "string" }
      }
    },
    "node": {
      "type": "object",
      "required": ["sectionId", "name", "requirementIds", "fingerprint", "dependsOn"],
      "properties": {
        "sectionId": { "type": "string", "pattern": "^S(?:0[1-9]|1[0-9])$" },
        "name": { "type": "string" },
        "requirementIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "dependsOn": { "type": "array", "items": { "type": "string", "pattern": "^S(?:0[1-9]|1[0-9])$" } }
      }
    },
    "contract": {
      "type": "object",
      "required": ["specificationSource", "designIndexSource", "designIndexFragment", "documentAudit", "requestContract"],
      "properties": {
        "specificationSource": { "type": "object" },
        "designIndexSource": { "type": "object" },
        "designIndexFragment": { "type": "string", "minLength": 1 },
        "documentAudit": {
          "type": "object",
          "required": ["fingerprint", "status", "outputDigest", "findingRequirementIds"],
          "properties": {
            "fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
            "status": { "enum": ["PASS", "DOCUMENT_GAP", "BLOCKED_MISSING_EVIDENCE", "BLOCKED_CONTRACT_CONFLICT", "UNKNOWN"] },
            "outputDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
            "findingRequirementIds": { "type": "array", "items": { "type": "string" } }
          }
        },
        "requestContract": { "type": ["object", "null"] }
      }
    },
    "evidence": { "type": "array", "items": { "type": "object" } },
    "implementation": {
      "type": "object",
      "required": ["files", "runtimeFacts"],
      "properties": { "files": { "type": "array" }, "runtimeFacts": { "type": "object" } }
    },
    "policy": {
      "type": "object",
      "required": ["allowedReadGlobs", "allowedWriteGlobs", "immutableInputGlobs", "forbiddenOperations", "maxChangedFiles", "maxChangedLines"],
      "properties": {
        "allowedReadGlobs": { "type": "array" }, "allowedWriteGlobs": { "type": "array" },
        "immutableInputGlobs": { "type": "array" }, "forbiddenOperations": { "type": "array" },
        "maxChangedFiles": { "type": "integer" }, "maxChangedLines": { "type": "integer" }
      }
    },
    "payload": { "type": "object" }
  }
}
